# Font
font_family      MesloLGS NF Regular
font_size        11.0

# Cursor
cursor_shape     beam
cursor_trail     1

# Window
window_margin_width     8
confirm_os_window_close 0

# shell
shell fish

# Copy / paste
map alt+c       copy_or_interrupt
map alt++c copy_to_clipboard
map alt+v paste_from_clipboard

# Scroll
map page_up      scroll_page_up
map page_down    scroll_page_down

# Tab bar position and style
tab_bar_edge         top
tab_bar_style        powerline
tab_bar_align        left  
tab_powerline_style  round 
# Tab title format
tab_title_template "{index}"


# Colors
active_tab_foreground   #050000
active_tab_background   #eee
active_tab_font_style   bold
inactive_tab_foreground #444
inactive_tab_background #999


map alt+t           new_tab
map alt+q           close_tab
map alt+right       next_tab
map alt+left        previous_tab
map alt+.           move_tab_forward
map alt+,           move_tab_backward
map ctrl+alt+t      set_tab_title

# Zoom
map alt+plus        change_font_size all +1
map alt+equal       change_font_size all +1
map alt+kp_add      change_font_size all +1
map alt+minus       change_font_size all -1
map alt+underscore  change_font_size all -1
map alt+kp_subtract change_font_size all -1
map alt+0           change_font_size all 0
map alt+kp_0        change_font_size all 0

# user overrides: ~/.config/kitty/user.conf is never shipped, never touched on
# update, loads last so your stuff wins. globinclude is silent if missing.
globinclude user.conf
