layout {

    focus-ring {
        active-color   "#e4677d"
        inactive-color "#000000"
        urgent-color   "#fd4663"
    }

    border {
        active-color   "#e4677d"
        inactive-color "#000000"
        urgent-color   "#fd4663"
    }

    shadow {
        color "#29141870"
    }

    tab-indicator {
        active-color   "#e4677d"
        inactive-color "#8d0c22"
        urgent-color   "#fd4663"
    }

    insert-hint {
        color "#e4677d80"
    }
}

recent-windows {
    highlight {
        active-color "#e4677d"
        urgent-color "#fd4663"
    }
}
