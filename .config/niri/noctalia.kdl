layout {

    focus-ring {
        active-color   "#67a9e4"
        inactive-color "#000000"
        urgent-color   "#fd4663"
    }

    border {
        active-color   "#67a9e4"
        inactive-color "#000000"
        urgent-color   "#fd4663"
    }

    shadow {
        color "#111f2d70"
    }

    tab-indicator {
        active-color   "#67a9e4"
        inactive-color "#0c508d"
        urgent-color   "#fd4663"
    }

    insert-hint {
        color "#67a9e480"
    }
}

recent-windows {
    highlight {
        active-color "#67a9e4"
        urgent-color "#fd4663"
    }
}
