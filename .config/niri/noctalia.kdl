layout {

    focus-ring {
        active-color   "#e77489"
        inactive-color "#000000"
        urgent-color   "#d28996"
    }

    border {
        active-color   "#e77489"
        inactive-color "#000000"
        urgent-color   "#d28996"
    }

    shadow {
        color "#29141870"
    }

    tab-indicator {
        active-color   "#e77489"
        inactive-color "#9c0c26"
        urgent-color   "#d28996"
    }

    insert-hint {
        color "#e7748980"
    }
}

recent-windows {
    highlight {
        active-color "#e77489"
        urgent-color "#d28996"
    }
}
