layout {

    focus-ring {
        active-color   "#677fe4"
        inactive-color "#000000"
        urgent-color   "#c97979"
    }

    border {
        active-color   "#677fe4"
        inactive-color "#000000"
        urgent-color   "#c97979"
    }

    shadow {
        color "#15182970"
    }

    tab-indicator {
        active-color   "#677fe4"
        inactive-color "#0c248d"
        urgent-color   "#c97979"
    }

    insert-hint {
        color "#677fe480"
    }
}

recent-windows {
    highlight {
        active-color "#677fe4"
        urgent-color "#c97979"
    }
}
