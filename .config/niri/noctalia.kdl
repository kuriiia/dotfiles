layout {

    focus-ring {
        active-color   "#677ee4"
        inactive-color "#000000"
        urgent-color   "#d37879"
    }

    border {
        active-color   "#677ee4"
        inactive-color "#000000"
        urgent-color   "#d37879"
    }

    shadow {
        color "#181a2570"
    }

    tab-indicator {
        active-color   "#677ee4"
        inactive-color "#0c238d"
        urgent-color   "#d37879"
    }

    insert-hint {
        color "#677ee480"
    }
}

recent-windows {
    highlight {
        active-color "#677ee4"
        urgent-color "#d37879"
    }
}
