// Animations
animations {
    workspace-switch {
        spring damping-ratio=0.65 stiffness=500 epsilon=0.0001
    }
    window-open {
        duration-ms 1000
        curve "ease-out-cubic"
        custom-shader r"
            vec4 open_color(vec3 coords_geo, vec3 size_geo) {
                float p = niri_clamped_progress;
                vec2 uv = coords_geo.xy;
                float seed = niri_random_seed * 6.28318;

                float amplitude = 100.0;
                float speed = 50.0;

                vec2 dir = uv - vec2(0.5);
                float dist = length(dir);

                float intensity = (1.0 - p) * (1.0 - p);
                vec2 offset = dir * (sin(p * dist * amplitude - p * speed + seed) + 0.5) / 30.0;

                vec2 wuv = uv + offset * intensity;
                vec3 tc = niri_geo_to_tex * vec3(wuv, 1.0);
                vec4 color = texture2D(niri_tex, tc.st);

                float alpha = smoothstep(0.0, 0.3, p);
                return color * alpha;
            }"
    }
    window-close {
        duration-ms 1000
        curve "ease-out-cubic"
        custom-shader r"
            vec4 close_color(vec3 coords_geo, vec3 size_geo) {
                float p = niri_clamped_progress;
                vec2 uv = coords_geo.xy;
                float seed = niri_random_seed * 6.28318;

                float amplitude = 100.0;
                float speed = 50.0;

                vec2 dir = uv - vec2(0.5);
                float dist = length(dir);

                float intensity = p * p;
                vec2 offset = dir * (sin(p * dist * amplitude - p * speed + seed) + 0.5) / 30.0;

                vec2 wuv = uv + offset * intensity;
                vec3 tc = niri_geo_to_tex * vec3(wuv, 1.0);
                vec4 color = texture2D(niri_tex, tc.st);

                float alpha = smoothstep(1.0, 0.5, p);
                return color * alpha;
            }"
    }
    horizontal-view-movement {
        spring damping-ratio=0.65 stiffness=500 epsilon=0.0001
    }
    window-movement {
        spring damping-ratio=0.65 stiffness=500 epsilon=0.0001
    }
    window-resize {
        spring damping-ratio=0.65 stiffness=500 epsilon=0.0001
        custom-shader r"
            vec4 resize_color(vec3 coords_curr_geo, vec3 size_curr_geo) {
                vec3 coords_tex_next = niri_geo_to_tex_next * coords_curr_geo;
                vec4 color = texture2D(niri_tex_next, coords_tex_next.st);
                return color;
            }"
    }
    config-notification-open-close {
        spring damping-ratio=0.65 stiffness=700 epsilon=0.001
    }
    screenshot-ui-open {
        spring damping-ratio=0.55 stiffness=600 epsilon=0.0001
    }
    overview-open-close {
        spring damping-ratio=0.75 stiffness=400 epsilon=0.0003
    }
}