layout {

    focus-ring {
        active-color   "#e665a8"
        inactive-color "#000000"
        urgent-color   "#da407d"
    }

    border {
        active-color   "#e665a8"
        inactive-color "#000000"
        urgent-color   "#da407d"
    }

    shadow {
        color "#29141f70"
    }

    tab-indicator {
        active-color   "#e665a8"
        inactive-color "#8f0a4f"
        urgent-color   "#da407d"
    }

    insert-hint {
        color "#e665a880"
    }
}

recent-windows {
    highlight {
        active-color "#e665a8"
        urgent-color "#da407d"
    }
}
